    "/api/v1/sync/status": {
      "get": {
        "tags": [
          "ERP Sync"
        ],
        "summary": "When the ERP data was last synchronized and whether the ERP answered",
        "responses": {
          "200": {
            "description": "Synchronization status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "lastSuccessfulSyncAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    },
                    "running": {
                      "type": "boolean"
                    },
                    "erpAvailable": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "lastSuccessfulSyncAt",
                    "running",
                    "erpAvailable"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sync/runs": {
      "get": {
        "tags": [
          "ERP Sync"
        ],
        "summary": "List the latest synchronization runs (administrators only)",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Runs, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "AUTOMATIC",
                          "MANUAL"
                        ]
                      },
                      "startedAt": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "finishedAt": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "format": "date-time"
                      },
                      "result": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "SUCCESS",
                          "PARTIAL",
                          "FAILED",
                          "RATE_LIMITED",
                          null
                        ]
                      },
                      "recordsRead": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "recordsChanged": {
                        "type": "integer",
                        "minimum": 0
