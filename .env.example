NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/node_boilerplate?schema=public
ERP_API_URL=https://pta-erp-api.onrender.com
ERP_API_KEY=replace-with-squad-erp-key
ERP_REQUEST_TIMEOUT_MS=60000
# Automatic ERP synchronization every 30 minutes. Each run spends calls of the
# quota shared by the whole squad, so keep it false locally and use
# POST /api/v1/sync/run when you need data. It defaults to true when unset.
ERP_SYNC_ENABLED=false
# Stopgap admin credential until login exists (F01). Optional; without it the
# admin endpoints refuse every request. Use at least 32 random characters.
# ADMIN_API_TOKEN=replace-with-a-random-value-of-32-or-more-characters
